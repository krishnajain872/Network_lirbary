{
    "name": "Network Library Dev",

    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "BUILDKIT_INLINE_CACHE": "1"
        },
        "cacheFrom": [
            "network-library-dev:latest"
        ]
    },

    /* =====================================================
       🔑 CRITICAL: DO NOT OVERRIDE CMD (allows sshd to run)
       ===================================================== */
    "overrideCommand": false,

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "golang.go",
                "eamodio.gitlens",
                "usernamehw.errorlens"
            ],

            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",

                "cmake.configureOnOpen": false,
                "cmake.generator": "Ninja",
                "cmake.buildDirectory": "${workspaceFolder}/build",
                "cmake.configureSettings": {
                    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                    "CMAKE_BUILD_TYPE": "Debug",
                    "CMAKE_C_COMPILER": "/usr/bin/gcc-12",
                    "CMAKE_CXX_COMPILER": "/usr/bin/g++-12"
                },
                "cmake.parallelJobs": 0,
                "cmake.buildBeforeRun": true,

                "C_Cpp.intelliSenseEngine": "default",
                "C_Cpp.default.compilerPath": "/usr/bin/g++-12",
                "C_Cpp.default.cppStandard": "c++20",
                "C_Cpp.default.cStandard": "c17",
                "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
                "C_Cpp.codeAnalysis.clangTidy.enabled": false,
                "C_Cpp.enhancedColorization": "enabled",

                "go.useLanguageServer": true,
                "go.gopath": "/go",
                "go.toolsManagement.autoUpdate": false,
                "go.lintTool": "golangci-lint",
                "go.lintOnSave": "workspace",
                "go.formatTool": "goimports",
                "go.testFlags": ["-v"],

                "editor.formatOnSave": true,
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "editor.rulers": [80, 120],

                "files.associations": {
                    "*.h": "c",
                    "*.hpp": "cpp"
                },
                "files.exclude": {
                    "**/.git": true,
                    "**/__pycache__": true,
                    "**/node_modules": true
                },
                "files.watcherExclude": {
                    "**/build/**": true,
                    "**/node_modules/**": true,
                    "**/.git/objects/**": true
                },

                "search.exclude": {
                    "**/build": true,
                    "**/node_modules": true,
                    "**/.git": true
                },

                "git.autofetch": true,
                "git.confirmSync": false,
                "telemetry.telemetryLevel": "off"
            }
        }
    },

    /* =====================================================
       🧠 DEBUGGING + PERF FLAGS (NO HOST NETWORK)
       ===================================================== */
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined",
        "--init"
    ],

    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
        "type=volume,source=network-lib-go-cache,target=/go/pkg",
        "type=volume,source=network-lib-ccache,target=/workspaces/network-library/.ccache"
    ],

    "forwardPorts": [22, 8080, 50051, 9090],

    "portsAttributes": {
        "22": {
            "label": "SSH",
            "onAutoForward": "silent"
        },
        "8080": {
            "label": "HTTP Server",
            "onAutoForward": "notify"
        },
        "50051": {
            "label": "gRPC Server",
            "onAutoForward": "notify"
        },
        "9090": {
            "label": "Metrics",
            "onAutoForward": "silent"
        }
    },

    "postCreateCommand": "mkdir -p build && echo '✅ Dev container ready! Run: cd build && cmake .. && ninja'",
    "postStartCommand": "git config --global --add safe.directory /workspaces/network-library",

    /* =====================================================
       👤 USE ROOT (matches sshd + tooling)
       ===================================================== */
    "remoteUser": "root",
    "workspaceFolder": "/workspaces/network-library",

    "containerEnv": {
        "WORKSPACE": "/workspaces/network-library",
        "CCACHE_DIR": "/workspaces/network-library/.ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },

    "features": {}
}
